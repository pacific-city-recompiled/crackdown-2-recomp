+// Overlapped WSARecvFrom/WSASendTo + WSAGetOverlappedResult. Crackdown 2's Live
+// networking engine (sub_82C7B680) posts an overlapped WSARecvFrom on its UDP
+// socket and treats anything but WSA_IO_PENDING (997) as fatal; the old stub
+// returned -1 with last error 0, so engine creation failed (0x807A100A) and
+// Quick Match crashed on a null engine (guest 0x838015CC). A pending receive is
+// polled by one host thread and completed into the guest OVERLAPPED (internal =
+// status, internal_high = bytes, offset.high = flags) with its event set.
+namespace {
+constexpr uint32_t kIoPending = 997, kIoIncomplete = 996, kAborted = 995;
+struct PendingRecv {
+  uint32_t socket, overlapped, from;
+  std::vector<std::pair<uint32_t, uint32_t>> buffers;  // guest ptr, len
+};
+std::mutex pending_mutex;
+std::condition_variable pending_cv;
+std::vector<PendingRecv> pending_recvs;
+bool pending_thread_started = false;
+
+// Native nonblocking receive into the guest buffers. Writes no guest last error
+// (it also runs on the host poll thread). Returns bytes, or -1 with *error set.
+int TryRecv(const PendingRecv& op, uint32_t* error) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(op.socket);
+  if (!socket) { *error = 10038; return -1; }
+  uint32_t total = 0;
+  for (auto& b : op.buffers) total += b.second;
+  std::vector<uint8_t> data(total ? total : 1);
+  sockaddr_in native{};
+#if REX_PLATFORM_WIN32
+  int len = sizeof(native);
+#else
+  socklen_t len = sizeof(native);
+#endif
+  int ret = recvfrom(socket->native_handle(), reinterpret_cast<char*>(data.data()), int(total), 0,
+                     reinterpret_cast<sockaddr*>(&native), &len);
+  if (ret < 0) {
+#if REX_PLATFORM_WIN32
+    *error = WSAGetLastError();
+    if (*error != WSAEMSGSIZE) return -1;
+    ret = int(total);  // truncated datagram: deliver what fits
+#else
+    *error = (errno == EAGAIN || errno == EWOULDBLOCK) ? 10035 : 10054;
+    return -1;
+#endif
+  }
+  uint32_t copied = 0;
+  for (auto& b : op.buffers) {
+    uint32_t n = std::min<uint32_t>(b.second, uint32_t(ret) - copied);
+    if (n) std::memcpy(REX_KERNEL_MEMORY()->TranslateVirtual(b.first), data.data() + copied, n);
+    copied += n;
+  }
+  auto endpoint = REX_KERNEL_STATE()->coop_network().Source(
+      {ntohl(native.sin_addr.s_addr), ntohs(native.sin_port)});
+  if (op.from) {
+    auto from = REX_KERNEL_MEMORY()->TranslateVirtual<XSOCKADDR_IN*>(op.from);
+    from->sin_family = AF_INET;
+    from->sin_port = endpoint.port;
+    from->sin_addr = endpoint.ip;
+    std::memset(from->x_sin_zero, 0, 8);
+  }
+  if (REXCVAR_GET(net_trace))
+    REXLOG_INFO("net WSARecvFrom handle={:08X} bytes={} guest={:08X}:{}", op.socket, ret,
+                endpoint.ip, endpoint.port);
+  *error = 0;
+  return ret;
+}
+
+void CompleteOverlapped(uint32_t overlapped, uint32_t status, uint32_t bytes) {
+  auto o = REX_KERNEL_MEMORY()->TranslateVirtual<XWSAOVERLAPPED*>(overlapped);
+  o->internal_high = bytes;
+  o->offset.high = 0;  // flags
+  uint32_t event_handle = o->event_handle;
+  std::atomic_thread_fence(std::memory_order_release);
+  o->internal = status;
+  if (event_handle) {
+    if (auto event = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) event->Set(0, false);
+  }
+}
+
+void PendingRecvThread() {
+  std::unique_lock lock(pending_mutex);
+  for (;;) {
+    if (pending_recvs.empty()) {
+      pending_cv.wait(lock);
+      continue;
+    }
+    for (size_t i = 0; i < pending_recvs.size();) {
+      uint32_t error = 0;
+      int ret = TryRecv(pending_recvs[i], &error);
+      if (ret < 0 && error == 10035) {
+        ++i;
+        continue;
+      }
+      CompleteOverlapped(pending_recvs[i].overlapped, ret < 0 ? (error ? error : kAborted) : 0,
+                         ret < 0 ? 0 : uint32_t(ret));
+      pending_recvs.erase(pending_recvs.begin() + i);
+    }
+    pending_cv.wait_for(lock, std::chrono::milliseconds(1));
+  }
+}
