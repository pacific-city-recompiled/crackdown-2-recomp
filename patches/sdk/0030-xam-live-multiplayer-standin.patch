+u32 NetDll_WSAGetOverlappedResult_entry(u32 socket, ppc_ptr_t<XWSAOVERLAPPED> overlapped_ptr,
+                                        mapped_u32 bytes_ptr, u32 wait, mapped_u32 flags_ptr) {
+  if (!overlapped_ptr) {
+    XThread::SetLastError(10014);
+    return 0;
+  }
+  while (uint32_t(overlapped_ptr->internal) == kIoPending) {
+    if (!wait) {
+      XThread::SetLastError(kIoIncomplete);
+      return 0;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  std::atomic_thread_fence(std::memory_order_acquire);
+  if (bytes_ptr) *bytes_ptr = uint32_t(overlapped_ptr->internal_high);
+  if (flags_ptr) *flags_ptr = uint32_t(overlapped_ptr->offset.high);
+  uint32_t status = overlapped_ptr->internal;
+  if (status) {
+    XThread::SetLastError(status);
+    return 0;
+  }
+  return 1;
+}
