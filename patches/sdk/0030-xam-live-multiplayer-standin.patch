diff --git a/src/kernel/xam/coop_live_sessions.cpp b/src/kernel/xam/coop_live_sessions.cpp
new file mode 100644
index 0000000..f476115
--- /dev/null
+++ b/src/kernel/xam/coop_live_sessions.cpp
@@ -0,0 +1,501 @@
+// Serverless stand-in for Xbox Live matchmaking between co-op instances.
+//
+// Crackdown 2's multiplayer and campaign co-op are Live-only: Quick Match runs
+// XSessionSearchEx, probes the hosts with XNetQosLookup, and with no result
+// hosts itself (XSessionCreate + XNetQosListen). On the console XAM fills the
+// host's XSESSION_INFO and the Live service answers searches; here each host
+// answers them itself over UDP on guest port 1003 (bind IP, --net_port_offset),
+// and searches go to every configured peer (direct) or to broadcast (lan).
+// Wire format is little-endian, PC to PC, versioned by kMagic.
+#include <rex/kernel/xam/coop_live_sessions.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <random>
+#include <thread>
+#include <vector>
+
+#include <rex/logging.h>
+#include <rex/system/coop_network_context.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xevent.h>
+#include <rex/system/xmemory.h>
+
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using native_socket = SOCKET;
+static void CloseNative(native_socket s) { closesocket(s); }
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using native_socket = int;
+#define INVALID_SOCKET (-1)
+static void CloseNative(native_socket s) { close(s); }
+#endif
+
+namespace rex::kernel::xam::coop_live {
+using namespace rex::system;
+
+namespace {
+constexpr uint32_t kMagic = 0x324D4443;  // "CDM2"
+constexpr uint16_t kGuestPort = 1003;
+enum : uint32_t { kSearchRequest = 1, kSearchReply = 2, kQosRequest = 3, kQosReply = 4 };
+constexpr uint32_t kMaxContexts = 32, kMaxProperties = 32, kMaxQosData = 1024;
+constexpr uint32_t kCreateHost = 0x1;
+
+struct Context { uint32_t id, value; };
+struct Property { uint32_t id, type, size; uint64_t data; };
+
+struct SearchRequest {
+  uint32_t magic, type, nonce, num_ctx;
+  Context ctx[kMaxContexts];
+};
+struct SearchReply {
+  uint32_t magic, type, nonce;
+  XSESSION_INFO info;
+  uint32_t open_public, open_private, filled_public, filled_private, num_ctx, num_props;
+  Context ctx[kMaxContexts];
+  Property props[kMaxProperties];
+};
+struct QosRequest { uint32_t magic, type, nonce; XNKID kid; };
+struct QosReply {
+  uint32_t magic, type, nonce, enabled, size;
+  XNKID kid;
+  uint8_t data[kMaxQosData];
+};
+
+struct Hosted {
+  XSESSION_INFO info;
+  uint32_t flags, public_slots, private_slots, filled_public = 0, filled_private = 0;
+  std::vector<Context> contexts;
+  std::vector<Property> properties;
+};
+struct QosEntry { bool enabled = false; std::vector<uint8_t> data; };
+
+std::mutex mutex;
+std::map<uint32_t, Context> contexts;      // user 0 only, by id
+std::map<uint32_t, Property> properties;   // user 0 only, by id
+std::map<uint32_t, Hosted> hosted;         // by guest session object
+std::map<std::array<uint8_t, 8>, QosEntry> qos;
+std::atomic<bool> responder_started{false};
+
+CoopNetworkContext& Net() { return REX_KERNEL_STATE()->coop_network(); }
+
+sockaddr_in Native(CoopEndpoint e) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(e.ip);
+  a.sin_port = htons(e.port);
+  return a;
+}
+
+native_socket OpenUdp(CoopEndpoint bind_to, bool reuse) {
+  native_socket s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (s == INVALID_SOCKET) return s;
+  int one = 1;
+  setsockopt(s, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&one), sizeof(one));
+  if (reuse)
+    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+  auto a = Native(bind_to);
+  if (bind(s, reinterpret_cast<sockaddr*>(&a), sizeof(a)) != 0) {
+    REXLOG_WARN("coop_live: bind {:08X}:{} failed", bind_to.ip, bind_to.port);
+    CloseNative(s);
+    return INVALID_SOCKET;
+  }
+  return s;
+}
+
+// Waits up to timeout_ms for one datagram. Returns its size or -1.
+int RecvWithin(native_socket s, void* buf, int len, int timeout_ms, sockaddr_in* from) {
+  fd_set set;
+  FD_ZERO(&set);
+  FD_SET(s, &set);
+  timeval tv{timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+  if (select(int(s) + 1, &set, nullptr, nullptr, &tv) <= 0) return -1;
+#if REX_PLATFORM_WIN32
+  int from_len = sizeof(*from);
+#else
+  socklen_t from_len = sizeof(*from);
+#endif
+  return recvfrom(s, static_cast<char*>(buf), len, 0, reinterpret_cast<sockaddr*>(from), &from_len);
+}
+
+bool Matches(const Hosted& h, const std::vector<Context>& wanted) {
+  for (auto& w : wanted)
+    for (auto& c : h.contexts)
+      if (c.id == w.id && c.value != w.value) return false;
+  return true;
+}
+
+void Respond(native_socket s, const uint8_t* buf, int len, const sockaddr_in& from) {
+  if (len < 8) return;
+  uint32_t magic, type;
+  std::memcpy(&magic, buf, 4);
+  std::memcpy(&type, buf + 4, 4);
+  if (magic != kMagic) return;
+  if (type == kSearchRequest && len >= int(sizeof(SearchRequest))) {
+    SearchRequest req;
+    std::memcpy(&req, buf, sizeof(req));
+    std::vector<Context> wanted(req.ctx, req.ctx + std::min(req.num_ctx, kMaxContexts));
+    std::vector<SearchReply> replies;
+    {
+      std::lock_guard lock(mutex);
+      for (auto& [obj, h] : hosted) {
+        uint32_t open_public = h.public_slots > h.filled_public ? h.public_slots - h.filled_public : 0;
+        if (!open_public || !Matches(h, wanted)) continue;
+        SearchReply r{};
+        r.magic = kMagic; r.type = kSearchReply; r.nonce = req.nonce; r.info = h.info;
+        r.open_public = open_public;
+        r.open_private = h.private_slots > h.filled_private ? h.private_slots - h.filled_private : 0;
+        r.filled_public = h.filled_public; r.filled_private = h.filled_private;
+        r.num_ctx = uint32_t(std::min<size_t>(h.contexts.size(), kMaxContexts));
+        std::copy_n(h.contexts.begin(), r.num_ctx, r.ctx);
+        r.num_props = uint32_t(std::min<size_t>(h.properties.size(), kMaxProperties));
+        std::copy_n(h.properties.begin(), r.num_props, r.props);
+        replies.push_back(r);
+      }
+    }
+    for (auto& r : replies)
+      sendto(s, reinterpret_cast<const char*>(&r), sizeof(r), 0,
+             reinterpret_cast<const sockaddr*>(&from), sizeof(from));
+    REXLOG_INFO("coop_live: search from {:08X}:{} -> {} session(s)", ntohl(from.sin_addr.s_addr),
+                ntohs(from.sin_port), replies.size());
+  } else if (type == kQosRequest && len >= int(sizeof(QosRequest))) {
+    QosRequest req;
+    std::memcpy(&req, buf, sizeof(req));
+    QosReply r{};
+    r.magic = kMagic; r.type = kQosReply; r.nonce = req.nonce; r.kid = req.kid;
+    {
+      std::lock_guard lock(mutex);
+      auto it = qos.find(std::to_array(req.kid.ab));
+      if (it != qos.end()) {
+        r.enabled = it->second.enabled;
+        r.size = uint32_t(std::min<size_t>(it->second.data.size(), kMaxQosData));
+        std::memcpy(r.data, it->second.data.data(), r.size);
+      }
+    }
+    sendto(s, reinterpret_cast<const char*>(&r), int(offsetof(QosReply, data) + r.size), 0,
+           reinterpret_cast<const sockaddr*>(&from), sizeof(from));
+  }
+}
+
+void StartResponder() {
+  if (responder_started.exchange(true)) return;
+  auto bind_to = Net().BindEndpoint({0, kGuestPort});
+  std::thread([bind_to] {
+    native_socket s = OpenUdp(bind_to, true);
+    if (s == INVALID_SOCKET) return;
+    REXLOG_INFO("coop_live: answering session searches on {:08X}:{}", bind_to.ip, bind_to.port);
+    std::vector<uint8_t> buf(sizeof(SearchRequest) + 64);
+    for (;;) {
+      sockaddr_in from{};
+      int len = RecvWithin(s, buf.data(), int(buf.size()), 1000, &from);
+      if (len > 0) Respond(s, buf.data(), len, from);
+    }
+  }).detach();
+}
+
+// Where a host with this XNADDR answers: a configured peer (by its MAC-shaped
+// identity, as CoopNetworkContext::Resolve matches), else its IP, offset 0.
+CoopEndpoint HostEndpoint(const XNADDR& address) {
+  auto& net = Net();
+  std::lock_guard lock(net.mutex);
+  for (auto& peer : net.peers)
+    if (!std::memcmp(peer.address.abEnet, address.abEnet, 6))
+      return {peer.ip, uint16_t(kGuestPort + peer.offset)};
+  return {ntohl(address.ina.s_addr), kGuestPort};
+}
+
+void RegisterSessionKey(const XSESSION_INFO& info) {
+  auto& net = Net();
+  std::lock_guard lock(net.mutex);
+  net.keys[std::to_array(info.sessionID.ab)] = info.keyExchangeKey;
+}
+
+uint32_t Nonce() {
+  static std::atomic<uint32_t> next{std::random_device{}()};
+  return next++;
+}
+}  // namespace
+
+bool Enabled() { return Net().enabled; }
+
+void SetContext(uint32_t user_index, uint32_t id, uint32_t value) {
+  if (user_index) return;
+  std::lock_guard lock(mutex);
+  contexts[id] = {id, value};
+}
+
+bool GetContext(uint32_t user_index, uint32_t id, uint32_t* value) {
+  if (user_index) return false;
+  std::lock_guard lock(mutex);
+  auto it = contexts.find(id);
+  if (it == contexts.end()) return false;
+  *value = it->second.value;
+  return true;
+}
+
+void SetProperty(uint32_t user_index, uint32_t id, uint32_t size, uint32_t value_ptr) {
+  if (user_index || !value_ptr || (size != 4 && size != 8)) return;
+  auto p = REX_KERNEL_MEMORY()->TranslateVirtual<const uint8_t*>(value_ptr);
+  Property prop{id, size == 4 ? 1u : 2u, size, 0};
+  prop.data = size == 4 ? memory::load_and_swap<uint32_t>(p) : memory::load_and_swap<uint64_t>(p);
+  std::lock_guard lock(mutex);
+  properties[id] = prop;
+}
+
+void SessionCreate(uint32_t obj_ptr, uint32_t flags, uint32_t public_slots,
+                   uint32_t private_slots, uint32_t user_index, uint32_t session_info_ptr) {
+  if (!Enabled() || !session_info_ptr) return;
+  auto guest_info = REX_KERNEL_MEMORY()->TranslateVirtual<XSESSION_INFO*>(session_info_ptr);
+  if (!(flags & kCreateHost)) {
+    RegisterSessionKey(*guest_info);
+    REXLOG_INFO("coop_live: joined session {:02X}{:02X}{:02X}{:02X}.. host {:08X}",
+                guest_info->sessionID.ab[0], guest_info->sessionID.ab[1],
+                guest_info->sessionID.ab[2], guest_info->sessionID.ab[3],
+                ntohl(guest_info->hostAddress.ina.s_addr));
+    return;
+  }
+  Hosted h{};
+  std::random_device random;
+  for (auto& b : h.info.sessionID.ab) b = uint8_t(random());
+  h.info.sessionID.ab[0] &= 0x0f;  // System Link type: XNetRegisterKey accepts it
+  h.info.sessionID.ab[7] |= 1;
+  for (auto& b : h.info.keyExchangeKey.ab) b = uint8_t(random());
+  h.info.hostAddress = Net().local;
+  h.flags = flags;
+  h.public_slots = public_slots;
+  h.private_slots = private_slots;
+  {
+    std::lock_guard lock(mutex);
+    for (auto& [id, c] : contexts) h.contexts.push_back(c);
+    for (auto& [id, p] : properties) h.properties.push_back(p);
+    hosted[obj_ptr] = h;
+  }
+  *guest_info = h.info;
+  RegisterSessionKey(h.info);
+  StartResponder();
+  REXLOG_INFO("coop_live: hosting session {:02X}{:02X}{:02X}{:02X}.. flags {:08X} slots {}+{}",
+              h.info.sessionID.ab[0], h.info.sessionID.ab[1], h.info.sessionID.ab[2],
+              h.info.sessionID.ab[3], flags, public_slots, private_slots);
+}
+
+void SessionDelete(uint32_t obj_ptr) {
+  std::lock_guard lock(mutex);
+  hosted.erase(obj_ptr);
+}
+
+void SessionJoin(uint32_t obj_ptr, uint32_t count) {
+  std::lock_guard lock(mutex);
+  auto it = hosted.find(obj_ptr);
+  if (it != hosted.end()) it->second.filled_public += count;
+}
+
+void SessionModify(uint32_t obj_ptr, uint32_t flags, uint32_t public_slots, uint32_t private_slots) {
+  std::lock_guard lock(mutex);
+  auto it = hosted.find(obj_ptr);
+  if (it == hosted.end()) return;
+  it->second.flags = flags;
+  it->second.public_slots = public_slots;
+  it->second.private_slots = private_slots;
+}
+
+void Search(uint32_t num_results, uint32_t num_ctx, uint32_t ctx_ptr, uint32_t results_buffer_size,
+            uint32_t results_ptr) {
+  if (!results_ptr || results_buffer_size < sizeof(XSESSION_SEARCHRESULT_HEADER)) return;
+  auto memory = REX_KERNEL_MEMORY();
+  auto header = memory->TranslateVirtual<XSESSION_SEARCHRESULT_HEADER*>(results_ptr);
+  header->search_results_count = 0;
+  header->search_results_ptr = results_ptr + sizeof(XSESSION_SEARCHRESULT_HEADER);
+  if (!Enabled()) return;
+
+  SearchRequest req{};
+  req.magic = kMagic; req.type = kSearchRequest; req.nonce = Nonce();
+  req.num_ctx = std::min(num_ctx, kMaxContexts);
+  for (uint32_t i = 0; i < req.num_ctx; ++i) {
+    auto c = memory->TranslateVirtual<const uint8_t*>(ctx_ptr + i * 8);
+    req.ctx[i] = {memory::load_and_swap<uint32_t>(c), memory::load_and_swap<uint32_t>(c + 4)};
+  }
+  native_socket s = OpenUdp(Net().BindEndpoint({0, 0}), false);
+  if (s == INVALID_SOCKET) return;
+  for (auto dest : Net().Destinations({0xffffffff, kGuestPort})) {
+    auto a = Native(dest);
+    sendto(s, reinterpret_cast<const char*>(&req), sizeof(req), 0, reinterpret_cast<sockaddr*>(&a),
+           sizeof(a));
+  }
+  std::vector<SearchReply> found;
+  std::vector<uint8_t> buf(sizeof(SearchReply));
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+  while (found.size() < num_results) {
+    auto left = std::chrono::duration_cast<std::chrono::milliseconds>(
+        deadline - std::chrono::steady_clock::now()).count();
+    if (left <= 0) break;
+    sockaddr_in from{};
+    int len = RecvWithin(s, buf.data(), int(buf.size()), int(left), &from);
+    if (len != int(sizeof(SearchReply))) continue;
+    SearchReply r;
+    std::memcpy(&r, buf.data(), sizeof(r));
+    if (r.magic != kMagic || r.type != kSearchReply || r.nonce != req.nonce) continue;
+    bool own = false;
+    {
+      std::lock_guard lock(mutex);
+      for (auto& [obj, h] : hosted) own |= !std::memcmp(&h.info.sessionID, &r.info.sessionID, 8);
+    }
+    if (!own) found.push_back(r);
+  }
+  CloseNative(s);
+
+  // Results array, then each result's contexts and properties.
+  uint32_t used = sizeof(XSESSION_SEARCHRESULT_HEADER);
+  uint32_t count = 0;
+  for (auto& r : found) {
+    uint32_t extra = r.num_ctx * 8 + r.num_props * 24;
+    if (used + sizeof(XSESSION_SEARCHRESULT) * (count + 1) + extra > results_buffer_size) break;
+    ++count;
+    used += extra;
+  }
+  uint32_t extra_ptr = header->search_results_ptr + count * sizeof(XSESSION_SEARCHRESULT);
+  for (uint32_t i = 0; i < count; ++i) {
+    auto& r = found[i];
+    auto out = memory->TranslateVirtual<XSESSION_SEARCHRESULT*>(header->search_results_ptr) + i;
+    out->info = r.info;
+    out->open_public_slots = r.open_public;
+    out->open_private_slots = r.open_private;
+    out->filled_public_slots = r.filled_public;
+    out->filled_private_slots = r.filled_private;
+    out->contexts_count = r.num_ctx;
+    out->contexts_ptr = extra_ptr;
+    for (uint32_t c = 0; c < r.num_ctx; ++c) {
+      auto p = memory->TranslateVirtual<uint8_t*>(extra_ptr + c * 8);
+      memory::store_and_swap<uint32_t>(p, r.ctx[c].id);
+      memory::store_and_swap<uint32_t>(p + 4, r.ctx[c].value);
+    }
+    extra_ptr += r.num_ctx * 8;
+    out->properties_count = r.num_props;
+    out->properties_ptr = extra_ptr;
+    for (uint32_t c = 0; c < r.num_props; ++c) {
+      // XUSER_PROPERTY: u32 id, pad, XUSER_DATA { u8 type, pad[7], 8-byte union }.
+      auto p = memory->TranslateVirtual<uint8_t*>(extra_ptr + c * 24);
+      std::memset(p, 0, 24);
+      memory::store_and_swap<uint32_t>(p, r.props[c].id);
+      p[8] = uint8_t(r.props[c].type);
+      if (r.props[c].size == 4)
+        memory::store_and_swap<uint32_t>(p + 16, uint32_t(r.props[c].data));
+      else
+        memory::store_and_swap<uint64_t>(p + 16, r.props[c].data);
+    }
+    extra_ptr += r.num_props * 24;
+    RegisterSessionKey(r.info);
+  }
+  header->search_results_count = count;
+  REXLOG_INFO("coop_live: search found {} session(s)", count);
+}
+
+uint32_t QosListen(uint32_t kid_ptr, uint32_t data_ptr, uint32_t data_size, uint32_t flags) {
+  if (!Enabled() || !kid_ptr) return 0;
+  constexpr uint32_t kEnable = 1, kDisable = 2, kSetData = 4, kRelease = 16;
+  auto kid = std::to_array(REX_KERNEL_MEMORY()->TranslateVirtual<XNKID*>(kid_ptr)->ab);
+  {
+    std::lock_guard lock(mutex);
+    if (flags & kRelease) {
+      qos.erase(kid);
+    } else {
+      auto& entry = qos[kid];
+      if (flags & kEnable) entry.enabled = true;
+      if (flags & kDisable) entry.enabled = false;
+      if ((flags & kSetData) && data_ptr) {
+        auto p = REX_KERNEL_MEMORY()->TranslateVirtual<const uint8_t*>(data_ptr);
+        entry.data.assign(p, p + std::min(data_size, kMaxQosData));
+      }
+    }
+  }
+  StartResponder();
+  return 0;
+}
+
+uint32_t QosLookup(uint32_t count, uint32_t addrs_ptr, uint32_t kids_ptr, uint32_t event_handle,
+                   uint32_t out_qos_ptr) {
+  auto memory = REX_KERNEL_MEMORY();
+  std::vector<QosReply> replies(count);
+  std::vector<bool> answered(count, false);
+  if (Enabled() && count) {
+    native_socket s = OpenUdp(Net().BindEndpoint({0, 0}), false);
+    if (s != INVALID_SOCKET) {
+      std::vector<uint32_t> nonces(count);
+      for (uint32_t i = 0; i < count; ++i) {
+        auto addr = memory->TranslateVirtual<XNADDR*>(
+            memory::load_and_swap<uint32_t>(memory->TranslateVirtual<uint8_t*>(addrs_ptr + i * 4)));
+        auto kid = memory->TranslateVirtual<XNKID*>(
+            memory::load_and_swap<uint32_t>(memory->TranslateVirtual<uint8_t*>(kids_ptr + i * 4)));
+        QosRequest req{kMagic, kQosRequest, nonces[i] = Nonce(), *kid};
+        auto a = Native(HostEndpoint(*addr));
+        sendto(s, reinterpret_cast<const char*>(&req), sizeof(req), 0,
+               reinterpret_cast<sockaddr*>(&a), sizeof(a));
+      }
+      auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+      std::vector<uint8_t> buf(sizeof(QosReply));
+      for (uint32_t got = 0; got < count;) {
+        auto left = std::chrono::duration_cast<std::chrono::milliseconds>(
+            deadline - std::chrono::steady_clock::now()).count();
+        if (left <= 0) break;
+        sockaddr_in from{};
+        int len = RecvWithin(s, buf.data(), int(buf.size()), int(left), &from);
+        if (len < int(offsetof(QosReply, data))) continue;
+        QosReply r{};
+        std::memcpy(&r, buf.data(), len);
+        if (r.magic != kMagic || r.type != kQosReply) continue;
+        for (uint32_t i = 0; i < count; ++i)
+          if (nonces[i] == r.nonce && !answered[i]) {
+            replies[i] = r;
+            answered[i] = true;
+            ++got;
+          }
+      }
+      CloseNative(s);
+    }
+  }
+  uint32_t data_total = 0;
+  for (uint32_t i = 0; i < count; ++i) data_total += answered[i] ? replies[i].size : 0;
+  uint32_t size = 8 + 24 * std::max(count, 1u) + data_total;
+  uint32_t qos_ptr = memory->SystemHeapAlloc(size);
+  std::memset(memory->TranslateVirtual(qos_ptr), 0, size);
+  auto result = memory->TranslateVirtual<XNQOS*>(qos_ptr);
+  result->count = count;
+  result->count_pending = 0;
+  uint32_t data_ptr = qos_ptr + 8 + 24 * std::max(count, 1u);
+  for (uint32_t i = 0; i < count; ++i) {
+    auto& info = result->info[i];
+    constexpr uint8_t kComplete = 1, kContacted = 2, kDisabled = 4, kData = 8;
+    info.flags = kComplete;
+    if (!answered[i]) continue;
+    info.flags |= kContacted | (replies[i].enabled ? 0 : kDisabled);
+    info.probes_xmit = 4;
+    info.probes_recv = 4;
+    info.rtt_min_in_msecs = 1;
+    info.rtt_med_in_msecs = 2;
+    info.up_bits_per_sec = 10000000;
+    info.down_bits_per_sec = 10000000;
+    if (replies[i].size) {
+      info.flags |= kData;
+      info.data_len = uint16_t(replies[i].size);
+      info.data_ptr = data_ptr;
+      std::memcpy(memory->TranslateVirtual(data_ptr), replies[i].data, replies[i].size);
+      data_ptr += replies[i].size;
+    }
+  }
+  if (out_qos_ptr) memory::store_and_swap<uint32_t>(memory->TranslateVirtual(out_qos_ptr), qos_ptr);
+  if (event_handle) {
+    if (auto event = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) event->Set(0, false);
+  }
+  REXLOG_INFO("coop_live: QoS lookup {} target(s), {} answered", count,
+              std::count(answered.begin(), answered.end(), true));
+  return 0;
+}
